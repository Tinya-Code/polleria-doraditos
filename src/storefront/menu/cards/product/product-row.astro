---
/**
 * ProductRow — flat-price product design (image card).
 * State coverage: `flat-with-image` and `flat-no-image` (image is
 * optional inside this design).
 *
 * Props:
 * - `product`  — v2 product payload (required)
 * - `canOrder` — whether the storefront accepts orders right now
 *
 * Owns its root + the CLIENT CONTRACT `data-template-card`, `data-has-range`,
 * `data-product` — the page's click delegation reads it from the root.
 */
import Star from '../../../icons/star.astro';
import AddButton from '../../../commerce/add-button.astro';
import { precio } from '../../../utils/format.js';
import type { MenuProduct } from '../../../types/menu';

interface Props {
  product: MenuProduct;
  canOrder?: boolean;
}

const { product, canOrder = true } = Astro.props;

/**
 * Whether this card renders `product.description`.
 * Most products don't show a description even if the JSON has one;
 * combos keep theirs on their own card (`combo-card`).
 */
const SHOW_DESCRIPTION = false;

/** Minimum price (the API computes it); the flat price otherwise. */
const startingPrice = product.price;
const hasImage = !!product.image?.url;
---

<!-- DISEÑO: Card de producto con imagen -->
<div
  data-template-card
  data-has-range="false"
  data-product={JSON.stringify(product ?? {})}
  class="group relative w-full h-full bg-primary rounded-2xl shadow-xl overflow-hidden flex flex-col transition-all duration-300 hover:shadow-2xl cursor-pointer"
>
  {
    hasImage && (
      <div class="w-full h-48 flex items-center justify-center pt-4 px-4 shrink-0">
        <img
          src={product.image.url}
          alt={product.image.alt}
          loading="lazy"
          class="w-full h-full object-contain drop-shadow-md transform group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    )
  }

  <div class="px-5 py-4 flex flex-col flex-1 justify-between gap-2 text-center">
    <div>
      <h3 class="text-primary-text font-bold text-lg tracking-wide uppercase flex items-center justify-center gap-2">
        {product.name}
        {product.is_recommended && (
          <Star class="w-5 h-5 text-accent fill-accent shrink-0" />
        )}
      </h3>

      {
        SHOW_DESCRIPTION && product.description && (
          <p class="text-primary-text/80 text-xs leading-relaxed line-clamp-2">
            {product.description}
          </p>
        )
      }
    </div>

    <div class="flex items-center justify-between mt-auto pt-1">
      <span class="text-primary-text font-extrabold text-lg tracking-tight">
        {precio(startingPrice)}
        {product.qty_label && (
          <span class="ml-2 text-[10px] font-bold text-primary-text/60 uppercase tracking-widest">
            {product.qty_label}
          </span>
        )}
      </span>

      {canOrder && <AddButton variant="pill" text="AGREGAR" />}
    </div>
  </div>
</div>
